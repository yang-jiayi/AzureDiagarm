{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "azureOpenAiEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT}"
    },
    "azureOpenAiResourceId": {
      "value": "${AZURE_OPENAI_RESOURCE_ID}"
    },
    "feedbackEmailEndpoint": {
      "value": "${FEEDBACK_EMAIL_ENDPOINT}"
    },
    "feedbackEmailSender": {
      "value": "${FEEDBACK_EMAIL_SENDER}"
    },
    "feedbackEmailRecipient": {
      "value": "${FEEDBACK_EMAIL_RECIPIENT}"
    },
    "azureTablesEndpoint": {
      "value": "${AZURE_TABLES_ENDPOINT}"
    },
    "azureTablesFeedbackTable": {
      "value": "${AZURE_TABLES_FEEDBACK_TABLE}"
    },
    "frontDoorId": { "value": "${FRONT_DOOR_ID}" },
    "publicAppUrl": { "value": "${PUBLIC_URL}" },
    "accessAdminEmail": { "value": "${ACCESS_ADMIN_EMAIL}" },
    "accessKeyVaultResourceId": { "value": "${AZURE_ACCESS_KEY_VAULT_RESOURCE_ID}" },
    "accessTablesEndpoint": { "value": "${AZURE_TABLES_ACCESS_ENDPOINT}" },
    "aiBudgetStore": { "value": "${AI_BUDGET_STORE}" },
    "aiBudgetTablesEndpoint": { "value": "${AZURE_TABLES_BUDGET_ENDPOINT}" },
    "aiBudgetTable": { "value": "${AZURE_TABLES_BUDGET_TABLE}" },
    "easyAuthVerified": { "value": false },
    "feedbackLegacyRetentionEnabled": { "value": false },
    "openAiDeploymentGpt6Astra": {
      "value": "${AZURE_OPENAI_DEPLOYMENT_GPT6ASTRA}"
    },
    "allowByoAIEndpoints": {
      "value": false
    },
    "deploySpeech": {
      "value": true
    },
    "speechRegion": {
      "value": "${AZURE_SPEECH_REGION}"
    },
    "deployCosmos": {
      "value": false
    },
    "mcpAuthToken": {
      "value": "${MCP_AUTH_TOKEN}"
    }
  }
}
