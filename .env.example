# ─── Azure OpenAI Configuration ───
# SECURITY: Azure OpenAI calls are proxied server-side by the co-located token
# server (server/token-server.js) at /api/openai. The API key is NEVER shipped
# to the browser. Keyless auth (managed identity / `az login`) is preferred; a
# key is only used as a fallback when one is provided to the server.
#
#   Local dev: scripts/start-token-server.sh bridges these VITE_ values to the
#     server-side names the proxy reads (AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY).
#   Container/ACA: set AZURE_OPENAI_ENDPOINT (and optionally AZURE_OPENAI_API_KEY)
#     as RUNTIME env — azd/Bicep and scripts/update_aca.sh wire this for you.
VITE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here   # optional server-side fallback; prefer managed identity

# Azure subscription used by helper scripts (e.g. scripts/llm-cost-report.py).
# Keep your real subscription ID out of committed code — set it here in .env.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Model Deployments (configure one or more)
# The app supports model selection in the UI - configure all deployments you want to use

# GPT-5.1 (Hybrid) - Fast by default (reasoning=none), optional reasoning when needed
VITE_AZURE_OPENAI_DEPLOYMENT_GPT51=gpt-5.1

# GPT-5.2 (Reasoning Model) - Best for complex architectures
VITE_AZURE_OPENAI_DEPLOYMENT_GPT52=gpt-5.2-chat

# GPT-5.4 (Reasoning Model) - Most capable frontier model for professional work
VITE_AZURE_OPENAI_DEPLOYMENT_GPT54=gpt-5.4

# GPT-5.4 Mini (Reasoning Model) - Compact frontier model, fast and cost-efficient
VITE_AZURE_OPENAI_DEPLOYMENT_GPT54MINI=gpt-5.4-mini

# GPT-5.6 Sol (Reasoning Model) - Newest frontier reasoning model
VITE_AZURE_OPENAI_DEPLOYMENT_GPT56SOL=gpt-5.6-sol

# GPT-5.6 Terra (Reasoning Model) - Grounded, thorough reasoning variant
VITE_AZURE_OPENAI_DEPLOYMENT_GPT56TERRA=gpt-5.6-terra

# GPT-5.6 Luna (Reasoning Model) - Fast, creative reasoning variant
VITE_AZURE_OPENAI_DEPLOYMENT_GPT56LUNA=gpt-5.6-luna

# Claude Opus 5 (Anthropic Messages API hosted in Microsoft Foundry)
# Requires a Foundry AIServices resource, model deployment, and managed-identity
# access with the https://ai.azure.com/.default token scope.
VITE_AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/
VITE_AZURE_FOUNDRY_DEPLOYMENT_CLAUDE_OPUS5=claude-opus-5
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/
# AZURE_FOUNDRY_API_KEY=your-foundry-key   # optional fallback; prefer managed identity
AZURE_FOUNDRY_ALLOWED_DEPLOYMENTS=claude-opus-5

# DeepSeek V3.2 Speciale - Strong structured output at lower cost (Chat Completions API)
VITE_AZURE_OPENAI_DEPLOYMENT_DEEPSEEK=DeepSeek-V3.2-Speciale
VITE_AZURE_OPENAI_DEPLOYMENT_DEEPSEEK_V4_PRO=DeepSeek-V4-Pro

# Grok 4.1 Fast - Fast non-reasoning model from xAI (Chat Completions API)
VITE_AZURE_OPENAI_DEPLOYMENT_GROK4FAST=grok-4-1-fast-non-reasoning
VITE_AZURE_OPENAI_DEPLOYMENT_GROK43=grok-4.3
VITE_AZURE_OPENAI_DEPLOYMENT_MISTRALLARGE3=Mistral-Large-3
VITE_AZURE_OPENAI_DEPLOYMENT_KIMIK25=Kimi-K2.5
VITE_AZURE_OPENAI_DEPLOYMENT_KIMIK27CODE=Kimi-K2.7-Code

# Legacy: Default deployment (used if specific model deployments not set)
# VITE_AZURE_OPENAI_DEPLOYMENT=your-deployment-name-here

# ─── Azure Speech Service (Avatar Presenter) ───
# Keyless auth: the container uses DefaultAzureCredential (az login in dev,
# managed identity in ACA) — no API key required or stored.
#
# VITE_SPEECH_REGION is a build-time flag that enables the "Present Critique"
# button. Set it to your Speech resource region (westus2, eastus2, etc.).
# AZURE_SPEECH_REGION is the runtime env var read by the token server inside
# the container (set as an ACA environment variable, not a build arg).
VITE_SPEECH_REGION=westus2
# AZURE_SPEECH_REGION and AZURE_SPEECH_RESOURCE_ID are runtime env vars read by the
# token server inside the container (set as ACA environment variables, not build args).
# AZURE_SPEECH_RESOURCE_ID is the full resource ID from `az cognitiveservices account show --query id`.
# VITE_AVATAR_CHARACTER=lisa
# VITE_AVATAR_STYLE=casual-sitting
# VITE_AVATAR_VOICE=en-US-AvaMultilingualNeural

# ─── Application Insights (Telemetry) ───
# Connection string from your App Insights resource in Azure Portal
# If not set, telemetry is disabled (app runs without tracking)
VITE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# ─── Azure Deployment Configuration (for scripts/deploy_aca.sh) ───
# These are only needed if deploying to Azure Container Apps

# Azure Container Registry name
ACR_NAME=your-acr-name

# Azure Container App name
ACA_APP_NAME=azure-diagram-builder

# Azure Resource Group
RESOURCE_GROUP=your-resource-group

# Docker image name (used in ACR)
IMAGE_NAME=azure-diagram-builder

# Optional runtime services used by the co-located API server
PUBLIC_URL=https://your-custom-domain.example
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Lowest-cost feedback delivery (preferred)
FEEDBACK_EMAIL_ENDPOINT=https://your-communication-service.communication.azure.com
FEEDBACK_EMAIL_SENDER=donotreply@your-managed-domain.azurecomm.net
FEEDBACK_EMAIL_RECIPIENT=feedback-owner@example.com
# Optional durable queryable archive
AZURE_TABLES_ENDPOINT=https://your-storage-account.table.core.windows.net
AZURE_TABLES_FEEDBACK_TABLE=feedback
# Existing Cosmos DB deployments remain supported as a fallback
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_DATABASE_ID=diagrams
COSMOS_CONTAINER_ID=diagrams
COSMOS_FEEDBACK_CONTAINER_ID=feedback
# ─── Authenticated diagram persistence (Azure Blob Storage) ───
# Stores per-user diagram documents, immutable versions, comments and share
# tokens under /api/diagrams. Keyless auth only: the token server uses
# DefaultAzureCredential (managed identity in ACA, `az login` in dev) — NO
# account keys or SAS. Grant the runtime identity "Storage Blob Data
# Contributor" on the account. When AZURE_BLOB_ENDPOINT is unset, /api/diagrams
# returns 503 and the feature is disabled.
AZURE_BLOB_ENDPOINT=https://your-storage-account.blob.core.windows.net
AZURE_BLOB_DIAGRAMS_CONTAINER=diagrams
AZURE_SPEECH_REGION=westus2
AZURE_SPEECH_RESOURCE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.CognitiveServices/accounts/...

# ─── Import from Azure (reverse-engineer a live Resource Group) ───
# Uses Azure Resource Graph (Reader-sufficient) to map a resource group into a
# diagram. Two modes:
#
# 1) Local / self-host (server identity): the token server queries Resource
#    Graph via DefaultAzureCredential (your `az login`, or a Reader-scoped
#    managed identity when self-hosted). Enable it explicitly — it is OFF by
#    default so a shared/public deployment never exposes the server identity.
# AZURE_IMPORT_ENABLED=true
#
# 2) Hosted (per-user delegated auth via MSAL):
#    each user signs in with Entra ID and the browser calls Resource Graph with
#    *their own* token (RBAC-scoped). Configure the app registration as either
#    single-tenant or multi-tenant to match the deployment. These are build-time
#    client values:
# VITE_AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000   # Application (client) ID of the SPA app registration
# VITE_AZURE_AD_AUTHORITY=https://login.microsoftonline.com/organizations   # 'organizations' (multi-tenant) or your tenant ID for single-tenant
# VITE_AZURE_AD_REDIRECT_URI=https://your-custom-domain.example   # optional; defaults to window.location.origin
# VITE_ARM_SCOPE=https://management.azure.com/user_impersonation   # delegated ARM scope requested at sign-in
