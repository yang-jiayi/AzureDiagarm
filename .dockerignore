# Allowlist-style .dockerignore: ignore everything by default, then re-include
# only the paths the Dockerfile actually needs. Keeps the ACR build context
# small (tens of MB instead of hundreds) and protects against accidental
# inclusion of new docs / research dirs.

**

# --- Build manifests & configs ---
!package.json
!package-lock.json
!index.html
!vite.config.ts
!tsconfig.json
!tsconfig.node.json
!eslint.config.js
!scripts/patch-image-size.mjs
# Imported by mcp-server/scripts/sync-pricing-data.mjs, which runs during the
# MCP build stage. Without it that stage fails with ERR_MODULE_NOT_FOUND.
!scripts/prep-pricing-data.mjs

# --- App source ---
!src/**

# --- Static assets copied to the build output root by Vite ---
!public/**

# --- Runtime assets served by nginx ---
!nginx.conf
!start.sh
!Azure_Public_Service_Icons/**

# --- Speech token server ---
!server/**

# --- MCP server (separate workspace, built in stage 1) ---
!mcp-server/package.json
!mcp-server/package-lock.json
!mcp-server/Dockerfile
!mcp-server/tsconfig.json
!mcp-server/src/**
!mcp-server/scripts/**

# --- Build-time App Insights input generated by the deployment script ---
!.env.appinsights*

# --- Re-exclusions inside allowed paths ---
**/node_modules
**/dist
**/.DS_Store
